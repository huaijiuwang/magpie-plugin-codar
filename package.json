    "url": "https://github.com/MisonL/magpie-plugin-codar/issues"
  },
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "internal.mjs",
    "catalog.mjs",
    "scripts/catalog.mjs",
    "test/plugin.test.mjs",
    "test/style.test.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
